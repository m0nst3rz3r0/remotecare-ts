# ════════════════════════════════════════════════════════════
# RemoteCare — environment variables
# Copy to .env.local for local dev, or set in the Vercel dashboard.
# ════════════════════════════════════════════════════════════

# Supabase project (safe to expose — RLS enforces all access)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Shared/clinic tablet mode — disables per-user auto-backup
VITE_SHARED_DEVICE=false

# Online operations always use the server login function.
# Deploy the Supabase migrations and functions before using cloud sync or SMS.
# SMS8_API_KEY, SMS8_DEVICE_ID and SMS8_SENDER_NUMBER belong only in
# Supabase Edge Function secrets. See ../supabase/SMS8_SETUP.md.
