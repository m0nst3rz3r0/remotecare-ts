# ════════════════════════════════════════════════════════════
# RemoteCare — environment variables
# Copy to .env.local for local dev, or set in the Vercel dashboard.
# ════════════════════════════════════════════════════════════

# Supabase project (safe to expose — RLS enforces all access)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Shared/clinic tablet mode — disables per-user auto-backup
VITE_SHARED_DEVICE=false

# Server-side auth (Phase 1 security upgrade).
# Set to "true" ONLY after:
#   1. Applying supabase/migrations 001–003
#   2. Deploying supabase/functions/login
# When true, login() routes through the login Edge Function (authV2)
# and the browser never reads the users table. Default false keeps
# the legacy client-side flow so nothing breaks before backend deploy.
VITE_USE_SERVER_AUTH=false
